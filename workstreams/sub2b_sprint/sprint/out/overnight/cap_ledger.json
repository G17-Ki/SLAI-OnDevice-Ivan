  "counting_conventions": {
    "learned_unique": {
      "definition": "Unique learned logical tensor elements. Proven tied weights are de-duplicated; fixed integer buffers, quantization scales/zero-points, graph constants, and non-neural rule data are excluded.",
      "relationship_to_cap": "This is the basis named by the user-facing strict parameter caps. A total must be strictly less than the cap, never equal to it.",
      "evidence_classes_used": [
        "EXACT"
      ]
    },
    "conservative_resident": {
      "definition": "A fail-safe upper-bound basis that counts serialized GGUF tensor elements reported by the running server and all ONNX initializer/Constant elements in resident exports, including quantization auxiliaries, fixed integer buffers, unused variants explicitly retained by the staged bundle, and selected style or voice banks.",
      "relationship_to_cap": "This basis can over-count unique learned parameters. If it is below the cap, the learned-parameter cap follows without relying on de-duplication. It must not be relabelled as an exact learned-parameter total.",
      "evidence_classes_used": [
        "PHONE-MEASURED",
        "EXACT",
        "UB"
      ]
    },
    "resident_inventory_rule": "Every model artifact retained across the main app and runtime-companion private directories counts in the conservative scope even when the current language selector cannot route to it. A target total becomes a physical-device claim only after a complete post-install file-and-hash inventory proves that excluded artifacts are absent.",
    "non_neural_frontends": "Rule tables, token lists, lexicons, and code have zero learned parameters. They still require file/hash inventory but add zero to the learned-parameter ledger.",
    "npu_boundary": "Parameter arithmetic proves no execution provider. No NPU claim follows from this ledger. NPU execution requires a version-matched compiled artifact and runtime plus phone telemetry."
  },
